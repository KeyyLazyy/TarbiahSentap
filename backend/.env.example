# Server Configuration
PORT=4000
JWT_SECRET=your-jwt-secret-key
CLIENT_ORIGIN=http://localhost:5173

# Firebase Configuration
# These are required to enable Firebase Authentication.
# If these variables are left empty, the server will fall back to Mock Authentication.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_API_KEY=your-firebase-web-api-key

# Private key must contain actual newlines. Copy the private key from your service account json
# and paste it here inside double quotes, ensuring '\n' escapes are preserved.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
